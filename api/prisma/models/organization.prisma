model Organization {
  id             String    @id @default(cuid())
  name           String
  hasStores      Boolean   @default(true)
  /// Without stores: true = credit organization (credits stock to branches, makes no sales of its own); false = direct sales.
  usesCreditBranches Boolean @default(false)
  billingEnabled    Boolean   @default(false)
  nextInvoiceNumber Int       @default(1)
  isActive          Boolean   @default(true)
  /// The host this organization signs in on (e.g. fonex.example.com). Several organizations may share one.
  domain            String?
  phone             String?
  evcNumber         String?
  edahabNumber      String?
  accountNumber     String?
  address           String?
  logoKey           String?
  logoUpdatedAt     DateTime?
  stampKey          String?
  stampUpdatedAt    DateTime?
  signatureKey      String?
  signatureUpdatedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users             User[]
  stores            Store[]
  categories        Category[]
  products          Product[]
  inventory         Inventory[]
  sales             Sale[]
  saleItems         SaleItem[]
  saleCorrections   SaleCorrection[]
  stockSupplies     StockSupply[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  auditLogs         AuditLog[]
  purchases         Purchase[]
  customers         Customer[]
  saleLocations     SaleLocation[]
  invoices          Invoice[]
  payments          Payment[]
  branchCredits     BranchCredit[]
  branchCreditItems BranchCreditItem[]
  branchReturns     BranchReturn[]
  branchPayments    BranchPayment[]

  @@index([domain])
  @@map("organization")
}
