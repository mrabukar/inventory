model Organization {
  id             String    @id @default(cuid())
  name           String
  hasStores      Boolean   @default(true)
  billingEnabled    Boolean   @default(false)
  nextInvoiceNumber Int       @default(1)
  isActive          Boolean   @default(true)
  phone             String?
  paymentNumber     String?
  address           String?
  logoKey           String?
  logoUpdatedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users             User[]
  stores            Store[]
  categories        Category[]
  products          Product[]
  inventory         Inventory[]
  sales             Sale[]
  saleItems         SaleItem[]
  saleCorrections   SaleCorrection[]
  stockSupplies     StockSupply[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  auditLogs         AuditLog[]
  purchases         Purchase[]
  customers         Customer[]
  saleLocations     SaleLocation[]
  invoices          Invoice[]
  payments          Payment[]

  @@map("organization")
}
