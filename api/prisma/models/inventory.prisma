model Inventory {
  id                String       @id @default(cuid())
  productId         String
  product           Product      @relation(fields: [productId], references: [id])
  storeId           String
  store             Store        @relation(fields: [storeId], references: [id])
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  quantity          Int          @default(0)
  lowStockThreshold Int          @default(5)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([productId, storeId])
  @@index([storeId])
  @@map("inventory")
}

enum SaleStatus {
  active
  corrected
}

model Sale {
  id             String       @id @default(cuid())
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  locationId     String?
  location       SaleLocation? @relation(fields: [locationId], references: [id])
  soldById       String
  soldBy         User          @relation("SalesSoldBy", fields: [soldById], references: [id])
  totalAmount    Decimal       @db.Decimal(10, 2)
  saleDate       DateTime      @db.Date
  note           String?
  status         SaleStatus    @default(active)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items       SaleItem[]
  corrections SaleCorrection[]
  invoice     Invoice?

  @@index([storeId])
  @@index([soldById])
  @@index([customerId])
  @@index([saleDate])
  @@map("sale")
}

model SaleItem {
  id                String       @id @default(cuid())
  saleId            String
  sale              Sale         @relation(fields: [saleId], references: [id])
  productId         String
  product           Product      @relation(fields: [productId], references: [id])
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  // Denormalized from the parent Sale (immutable after creation) so reports can
  // aggregate everything from sale_item alone.
  storeId           String
  saleDate          DateTime     @db.Date
  quantitySold      Int
  unitPrice         Decimal      @db.Decimal(10, 2)
  unitPurchasePrice Decimal      @db.Decimal(10, 2)
  lineTotal         Decimal      @db.Decimal(10, 2)
  createdAt         DateTime     @default(now())

  corrections SaleCorrection[]

  @@index([saleId])
  @@index([productId])
  @@index([organizationId])
  @@index([storeId])
  @@index([saleDate])
  @@map("sale_item")
}

model SaleCorrection {
  id                String       @id @default(cuid())
  saleId            String
  sale              Sale         @relation(fields: [saleId], references: [id])
  saleItemId        String
  saleItem          SaleItem     @relation(fields: [saleItemId], references: [id])
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  originalQuantity  Int
  correctedQuantity Int
  reason            String
  correctedById     String
  correctedBy       User         @relation("SaleCorrections", fields: [correctedById], references: [id])
  createdAt         DateTime     @default(now())

  @@index([saleId])
  @@index([saleItemId])
  @@map("sale_correction")
}

model StockSupply {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  storeId           String
  store             Store           @relation(fields: [storeId], references: [id])
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id])
  quantity          Int
  unitPurchasePrice Decimal         @db.Decimal(10, 2)
  type              StockSupplyType @default(supply)
  correctsSupplyId  String?
  correctsSupply    StockSupply?    @relation("StockSupplyCorrection", fields: [correctsSupplyId], references: [id])
  corrections       StockSupply[]   @relation("StockSupplyCorrection")
  suppliedById      String
  suppliedBy        User            @relation("StockSupplies", fields: [suppliedById], references: [id])
  note              String?
  createdAt         DateTime        @default(now())

  @@index([storeId])
  @@index([productId])
  @@index([correctsSupplyId])
  @@index([type])
  @@map("stock_supply")
}

enum StockSupplyType {
  supply
  correction_add
  correction_subtract
}
