/// A branch that buys stock from the organization on credit (only in
/// organizations without stores — see Store.type). The branch owns the stock
/// once credited and owes the organization for it; it pays back over time,
/// each payment reviewed by an admin.
model BranchCredit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  storeId        String
  store          Store        @relation("BranchCreditsForStore", fields: [storeId], references: [id])
  /// Sum of item line totals — what the branch owes for this credit.
  total          Decimal      @db.Decimal(12, 2)
  note           String?
  createdById    String
  createdBy      User         @relation("BranchCreditsCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  items    BranchCreditItem[]
  payments BranchPayment[]

  @@index([organizationId])
  @@index([storeId])
  @@map("branch_credit")
}

model BranchCreditItem {
  id             String       @id @default(cuid())
  branchCreditId String
  branchCredit   BranchCredit @relation(fields: [branchCreditId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  storeId        String
  quantity       Int
  /// Price charged to the branch for each unit.
  unitPrice      Decimal      @db.Decimal(10, 2)
  /// Organization's own cost per unit at credit time (for the org's profit).
  unitCost       Decimal      @db.Decimal(10, 2)
  lineTotal      Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())

  returns BranchReturn[]

  @@index([branchCreditId])
  @@index([productId])
  @@map("branch_credit_item")
}

model BranchReturn {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  storeId            String
  store              Store            @relation("BranchReturnsForStore", fields: [storeId], references: [id])
  branchCreditItemId String
  branchCreditItem   BranchCreditItem @relation(fields: [branchCreditItemId], references: [id])
  quantity           Int
  /// quantity × the credit line's unitPrice — what comes off the balance.
  amount             Decimal          @db.Decimal(12, 2)
  reason             String
  createdById        String
  createdBy          User             @relation("BranchReturnsCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())

  @@index([organizationId])
  @@index([storeId])
  @@index([branchCreditItemId])
  @@map("branch_return")
}

enum BranchPaymentMethod {
  cash
  evc
  edahab
  bank
}

enum BranchPaymentStatus {
  pending
  approved
  rejected
}

model BranchPayment {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id])
  storeId         String
  store           Store               @relation("BranchPaymentsForStore", fields: [storeId], references: [id])
  /// Set when this payment was recorded at credit time (already approved).
  branchCreditId  String?
  branchCredit    BranchCredit?       @relation(fields: [branchCreditId], references: [id])
  amount          Decimal             @db.Decimal(12, 2)
  paidAt          DateTime            @db.Date
  method          BranchPaymentMethod
  reference       String?
  status          BranchPaymentStatus @default(pending)
  submittedById   String
  submittedBy     User                @relation("BranchPaymentsSubmittedBy", fields: [submittedById], references: [id])
  reviewedById    String?
  reviewedBy      User?               @relation("BranchPaymentsReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())

  @@index([organizationId])
  @@index([storeId])
  @@index([status])
  @@map("branch_payment")
}
