# Neon PostgreSQL — use the direct (non-pooled) URL for migrations if pooled fails
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional: pooled URL for runtime (uncomment and use in production if desired)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"

# Better-Auth
# IMPORTANT: This value should be a randomly generated secret (32+ bytes).
# Generate one with: `npx auth secret` (Better-Auth CLI).
# Required in production (min 32 characters).
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:4000"
NODE_ENV=development

# Public sign-up: enabled by default in dev, disabled in production.
# Set to true to allow public sign-up in production (not recommended).
# ALLOW_PUBLIC_SIGNUP=false

PORT=4000

# Business calendar timezone (IANA). Used for sale/expense dates, reports, and dashboards.
APP_TIMEZONE=Africa/Mogadishu
